#!/bin/bash
#PBS -P xz2
#PBS -q copyq
#PBS -l walltime=4:00:00
#PBS -l mem=8GB
#PBS -l ncpus=1
#PBS -l wd
#PBS -r y
#PBS -l storage=scratch/xz2+gdata/xz2
#PBS -M <YOUR_EMAIL_HERE>

set -euo pipefail

# copyq is the Gadi queue with external network access. This job downloads the
# ESMFold model checkpoint into the torch hub cache used by run_esmfold.py.
module load python3/3.9.2

TORCH_HOME="${TORCH_HOME:-/scratch/xz2/$USER/torch_cache}"
MODEL_NAME="${MODEL_NAME:-esmfold_3B_v1}"
MODEL_URL="${MODEL_URL:-https://dl.fbaipublicfiles.com/fair-esm/models/${MODEL_NAME}.pt}"
TARGET_DIR="$TORCH_HOME/hub/checkpoints"
TARGET_PATH="$TARGET_DIR/${MODEL_NAME}.pt"
TMP_PATH="$TARGET_PATH.tmp.$$"

export TMPDIR="${PBS_JOBFS:-/tmp}"

mkdir -p "$TARGET_DIR"
trap 'rm -f "$TMP_PATH"' EXIT

if [[ -s "$TARGET_PATH" ]]; then
  echo "ESMFold weights already present: $TARGET_PATH"
  ls -lh "$TARGET_PATH"
  exit 0
fi

echo "Downloading ESMFold weights"
echo "  URL:    $MODEL_URL"
echo "  Target: $TARGET_PATH"

python3 - "$MODEL_URL" "$TMP_PATH" <<'PY'
import sys
import urllib.request
from pathlib import Path

url = sys.argv[1]
tmp_path = Path(sys.argv[2])

with urllib.request.urlopen(url) as response, tmp_path.open("wb") as handle:
    total = response.headers.get("Content-Length")
    total_bytes = int(total) if total else None
    downloaded = 0
    while True:
        chunk = response.read(1024 * 1024)
        if not chunk:
            break
        handle.write(chunk)
        downloaded += len(chunk)
        if total_bytes:
            pct = downloaded * 100 / total_bytes
            print(f"\r{downloaded / (1024 ** 3):.2f} GiB / {total_bytes / (1024 ** 3):.2f} GiB ({pct:.1f}%)", end="")
        else:
            print(f"\r{downloaded / (1024 ** 3):.2f} GiB", end="")
    print()
PY

mv "$TMP_PATH" "$TARGET_PATH"
trap - EXIT

echo "Download complete"
ls -lh "$TARGET_PATH"

cat <<EOF

Use this cache for ESMFold jobs:
  export TORCH_HOME=$TORCH_HOME

The checkpoint should be visible at:
  $TARGET_PATH
EOF
