#!/bin/bash
#PBS -P xz2
#PBS -q gpuvolta
#PBS -l walltime=48:00:00
#PBS -l mem=30GB
#PBS -l jobfs=20GB
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l wd
#PBS -r y
#PBS -l storage=scratch/xz2+gdata/xz2+gdata/if89
#PBS -M <YOUR_EMAIL_HERE>

set -euo pipefail

module load cuda/12.9.0 python3/3.10.4 python3-as-python
source /scratch/xz2/$USER/envs/colabdesign_modified/bin/activate

REPO_DIR="${REPO_DIR:-/scratch/xz2/$USER/scaffold_bind_craft}"
SETTINGS="${SETTINGS:-$REPO_DIR/settings/example.json}"
LIMIT="${LIMIT:-500}"
OUTPUT_DIR="${OUTPUT_DIR:-}"
VENV="${VENV:-/scratch/xz2/$USER/envs/colabdesign_modified}"

source "$VENV/bin/activate"
cd "$REPO_DIR"

args=(--settings "$SETTINGS" --limit "$LIMIT")
if [[ -n "$OUTPUT_DIR" ]]; then
  args+=(--output-dir "$OUTPUT_DIR")
fi

python3 scripts/run_colabdesign_rso.py "${args[@]}"
