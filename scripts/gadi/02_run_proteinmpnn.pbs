#!/bin/bash
#PBS -P xz2
#PBS -q gpuvolta
#PBS -l walltime=24:00:00
#PBS -l mem=30GB
#PBS -l jobfs=10GB
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l wd
#PBS -r y
#PBS -l storage=scratch/xz2+gdata/xz2
#PBS -M <YOUR_EMAIL_HERE>

set -euo pipefail

module load  python3/3.11.7 cuda/12.9.0
source /path/to/install/location/pmpnn/bin/activate

REPO_DIR="${REPO_DIR:-/scratch/xz2/$USER/scaffold_bind_craft}"
SETTINGS="${SETTINGS:-$REPO_DIR/settings/example.json}"
LIMIT="${LIMIT:-50}"
OUTPUT_DIR="${OUTPUT_DIR:-}"
VENV="${VENV:-/scratch/xz2/$USER/ProteinMPNN/.venv}"

source "$VENV/bin/activate"
cd "$REPO_DIR"

args=(--settings "$SETTINGS" --limit "$LIMIT")
if [[ -n "$OUTPUT_DIR" ]]; then
  args+=(--output-dir "$OUTPUT_DIR")
fi

python3 scripts/run_proteinmpnn.py "${args[@]}"
